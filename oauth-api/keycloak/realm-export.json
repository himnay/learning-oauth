{
  "realm": "learning",
  "enabled": true,
  "displayName": "Learning OAuth",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "api-user", "description": "Allowed to call the oauth-api REST API" }
    ]
  },
  "clients": [
    {
      "clientId": "node-pkce-app",
      "name": "Node PKCE App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4000",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:4000/callback"],
      "webOrigins": ["http://localhost:4000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4000/"
      },
      "protocolMappers": [
        {
          "name": "oauth-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "oauth-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-learning", "api-user"],
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ]
    },
    {
      "username": "noaccess",
      "email": "noaccess@example.com",
      "firstName": "No",
      "lastName": "Access",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-learning"],
      "credentials": [
        { "type": "password", "value": "noaccess", "temporary": false }
      ]
    }
  ]
}
